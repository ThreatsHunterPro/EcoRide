  "scripts": {
    "dev": "nodemon -r dotenv/config src/server.js",
    "start": "node -r dotenv/config src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:roles": "node -r dotenv/config scripts/seeds/roles.seed.js",
    "seed:brands": "node -r dotenv/config scripts/seeds/brands.seed.js",
    "seed:configurations": "node -r dotenv/config scripts/seeds/configurations.seed.js",
