    "seed:users": "node -r dotenv/config scripts/seeds/users.seed.js",
    "seed:cars": "node -r dotenv/config scripts/seeds/cars.seed.js",
    "seed:trips": "node -r dotenv/config scripts/seeds/trips.seed.js",
    "seed:bookings": "node -r dotenv/config scripts/seeds/bookings.seed.js",
    "seed:reviews": "node -r dotenv/config scripts/seeds/reviews.seed.js",
    "seed:all": "npm run seed:roles && npm run seed:brands && npm run seed:users && npm run seed:configurations && npm run seed:parameters && npm run seed:cars && npm run seed:trips && npm run seed:bookings && npm run seed:reviews",
    "db:count": "node -r dotenv/config scripts/count.db.js",
